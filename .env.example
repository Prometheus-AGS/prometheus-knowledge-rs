# =============================================================================
# prometheus-knowledge environment configuration
# Copy to .env and fill in values. Never commit .env to git.
# =============================================================================

# -------------------------------------
# Knowledge base location
# -------------------------------------
PK_KB_DIR=~/.prometheus/knowledge

# -------------------------------------
# MCP server bind address (pk-cherry)
# -------------------------------------
PK_BIND=127.0.0.1:8942

# -------------------------------------
# Model routing
#
# Compile: high-quality LLM structures raw docs into wiki articles
# Lint:    cheap local model scans wiki for issues
# Focus:   local model synthesizes mini-KBs
# Fix:     local model applies lint auto-fixes
# -------------------------------------

# Compile model — cloud provider via liter-llm or direct
PK_COMPILE_MODEL=claude-sonnet-4-6

# Lint / Focus / Fix — local Qwen via Cherry Studio or mistral.rs
PK_LINT_MODEL=qwen2.5-14b-instruct-q4_k_m
PK_FOCUS_MODEL=qwen2.5-14b-instruct-q4_k_m
PK_FIX_MODEL=qwen2.5-14b-instruct-q4_k_m

# -------------------------------------
# LLM endpoint configuration
# -------------------------------------

# Cloud endpoint (Anthropic, OpenAI-compat, liter-llm gateway)
CLOUD_LLM_URL=https://api.anthropic.com/v1
CLOUD_LLM_API_KEY=sk-ant-...

# Local endpoint (Cherry Studio, LM Studio, mistral.rs, candle-vllm)
LOCAL_LLM_URL=http://localhost:1234/v1
# LOCAL_LLM_URL=http://localhost:8080/v1   # candle-vllm directly

# -------------------------------------
# Logging
# -------------------------------------
RUST_LOG=pk_cherry=info,pk_librarian=info,pk_store=debug
