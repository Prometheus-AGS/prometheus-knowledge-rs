# Rust build artifacts
/target/
**/target/

# Cargo lock file (keep for binaries, workspace manages it)
# Cargo.lock is committed for binary crates

# Environment files (never commit secrets)
.env
.env.local
.env.*.local

# IDE / editor
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Claude Code session state
.claude/

# Logs
*.log
logs/

# Test artifacts
/tmp/

# Coverage reports
lcov.info
tarpaulin-report.html

# prometheus-context-bootstrap
.prometheus/.writer.lock
.prometheus/.review-pending
.claude/settings.json.bak.*

# agent-team-creator: local coordination state and install backups
.agent-team/*/state.json
.agent-team/recovery/

# pk wiki write lock and interrupted-write temp files
.prometheus/knowledge/wiki/.index.lock
.prometheus/knowledge/wiki/.*.tmp

# Compass: commit the config, graph and report; everything else in compass-out/ is local per-worktree state
compass-out/*
!compass-out/graph.json
!compass-out/GRAPH_REPORT.md
